---
import "../styles/estilos.css";

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
</head>

<body>
  <header class="barra-navegacion">
    <nav class="navegacion" aria-label="Navegación principal">
      <a href="/" class="marca">La furia</a>

      <div class="enlaces-navegacion">
        <a href="/" class="enlace-navegacion">Inicio</a>
        <a href="/obra" class="enlace-navegacion">La obra</a>
        <a href="/interpretaciones" class="enlace-navegacion">Interpretaciones</a>
      </div>
    </nav>
  </header>

  <slot />
</body>
</html>
